# ---------------------------------------------------------------------------
# Local development: `pnpm dev` loads this file as .env for the API and worker.
# The deployment bundle has its own, complete file: deploy/.env.example.
# Empty values count as unset. The API refuses to start with missing or weak
# secrets. Generate secrets with: openssl rand -base64 48
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=8787
# Postgres 15+ with the pgvector and pg_trgm extensions available.
DATABASE_URL=postgres://postgres:test@localhost:55432/postgres
# Public HTTPS base URL of the API (goes into the device pairing QR code).
# http is allowed only for localhost in development.
PUBLIC_BASE_URL=http://localhost:8787
# Origin of the setup page; the only origin CORS allows. Defaults to PUBLIC_BASE_URL.
# SETUP_ORIGIN=https://brain.example.com
# Optional: require this token (header X-Setup-Token) to create the owner account
# on first run, so nobody else can claim a freshly deployed instance.
SETUP_BOOTSTRAP_TOKEN=
# 32 random bytes (openssl rand -base64 32) that encrypt the provider API keys
# saved on the setup page. Without it, keys can only come from AI_* below.
APP_ENCRYPTION_KEY=
# Owner session lifetime for the setup page, in hours.
SESSION_TTL_HOURS=12
# Apply database migrations on start: true/false (also 1/0, yes/no). API and
# worker take a lock, so both may.
RUN_MIGRATIONS=true
# Run the job worker inside the API process (small installs). Otherwise run apps/worker.
EMBEDDED_WORKER=false
# Trust X-Forwarded-For for client IPs (set true behind Railway or a reverse proxy).
TRUST_PROXY=false
LOG_LEVEL=info

# Owner identity for the default intake filter (mentions and aliases in groups).
SELF_JID=447000000000@s.whatsapp.net
SELF_ALIASES=Alex,@Alex

# Push: VAPID contact (mailto: address or https: URL); keys are generated on first boot.
VAPID_SUBJECT=
# Hostname of a self-hosted ntfy server, exempt from the private-address SSRF
# check on push endpoint registration.
NTFY_HOST=

# ---------------------------------------------------------------------------
# OpenWA (ENGINE_TYPE=baileys). Read-only "viewer" key only.
# ---------------------------------------------------------------------------
OPENWA_BASE_URL=https://your-openwa.up.railway.app
# Browser address of the OpenWA dashboard (QR scan). Defaults to an https OPENWA_BASE_URL.
OPENWA_DASHBOARD_URL=
OPENWA_SESSION_ID=
OPENWA_READ_API_KEY=
# At least 32 random characters; must match the secret registered in OpenWA.
OPENWA_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Model providers: fallback per role when the setup page has not saved one.
# PROVIDER is openai, anthropic, or openai-compatible (needs BASE_URL).
# Roles: TEXT (required for analysis), VISION (defaults to TEXT), TRANSCRIPTION,
# EMBEDDING. Every role also takes _BASE_URL, _DAILY_TOKEN_LIMIT and
# _DAILY_CALL_LIMIT (blank = no limit); see deploy/.env.example for all of them.
# ---------------------------------------------------------------------------
AI_TEXT_PROVIDER=
AI_TEXT_MODEL=
AI_TEXT_API_KEY=
AI_TEXT_BASE_URL=
AI_TEXT_DAILY_TOKEN_LIMIT=
AI_TEXT_DAILY_CALL_LIMIT=

AI_VISION_PROVIDER=
AI_VISION_MODEL=
AI_VISION_API_KEY=

AI_TRANSCRIPTION_PROVIDER=
AI_TRANSCRIPTION_MODEL=
AI_TRANSCRIPTION_API_KEY=

AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_API_KEY=
# Vector size; search stores at most 1536. Default 1536 for openai.
AI_EMBEDDING_DIMENSIONS=

# Pipeline timings and media limits (ANALYSIS_*, MEDIA_*, MODEL_TIMEOUT_MS, ...)
# are optional; deploy/.env.example lists them with their defaults.

# Tests use TEST_DATABASE_URL (or DATABASE_URL) as the server on which each test
# file creates and drops its own database:
# docker run -d --name wabrain-pg-test -e POSTGRES_PASSWORD=test -p 55432:5432 pgvector/pgvector:pg17
# TEST_DATABASE_URL=postgres://postgres:test@localhost:55432/postgres
