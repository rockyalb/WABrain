# =============================================================================
# WABrain self-host bundle (deploy/docker-compose.yml)
# =============================================================================
# Run ./init.sh: it copies this file to .env and fills in every secret marked
# [generated]. It never overwrites a value that is already set.
#
# A blank value counts as unset. The API and the worker refuse to start (exit
# code 78) with missing or weak secrets and name the variable, never its value.
# Keep .env private (init.sh sets mode 600); it is ignored by git.

# -----------------------------------------------------------------------------
# Public address
# -----------------------------------------------------------------------------
# Domain of the API and setup page. The "https" profile (Caddy) gets a
# certificate for it; point its DNS record at this host first.
BRAIN_DOMAIN=brain.example.com
# Public HTTPS base URL of the API; goes into the device pairing QR code.
# Defaults to https://$BRAIN_DOMAIN. Set it when another proxy (Railway, nginx,
# Cloudflare Tunnel) terminates TLS instead of Caddy.
PUBLIC_BASE_URL=
# Origin of the setup page, the only origin CORS allows. Defaults to the origin
# of PUBLIC_BASE_URL (the API serves the setup page itself, so leave it blank).
SETUP_ORIGIN=
# Trust X-Forwarded-For for client IPs (rate limits). Set true behind Caddy or
# any other reverse proxy; keep false when the API port is reached directly.
TRUST_PROXY=true
# Where the API port is published on the host. The default keeps it on
# localhost (Caddy reaches the API over the internal network).
API_BIND_ADDRESS=127.0.0.1
API_PUBLISH_PORT=8787

# -----------------------------------------------------------------------------
# Secrets [generated by init.sh]
# -----------------------------------------------------------------------------
# Password of the "wabrain" Postgres user. Only read when the database volume
# is first created; changing it later needs ALTER USER inside Postgres too.
POSTGRES_PASSWORD=
# HMAC secret for OpenWA webhooks (X-OpenWA-Signature). At least 32 random
# characters. register-webhook.sh registers the same value in OpenWA.
OPENWA_WEBHOOK_SECRET=
# Required (header X-Setup-Token) to create the owner account on first run, so
# nobody else can claim a fresh instance. The setup page asks for it once.
SETUP_BOOTSTRAP_TOKEN=
# 32 random bytes (base64 or hex). Encrypts model-provider API keys stored from
# the setup page (AES-256-GCM). Losing it means re-entering those keys.
APP_ENCRYPTION_KEY=
# OpenWA admin key (API_MASTER_KEY inside the openwa service only). Used for the
# OpenWA dashboard and by register-webhook.sh; never given to the API or worker.
OPENWA_API_MASTER_KEY=
# Pepper for OpenWA's API-key hashes. Changing it invalidates every OpenWA key.
OPENWA_API_KEY_PEPPER=

# -----------------------------------------------------------------------------
# OpenWA (WhatsApp gateway, Baileys engine)
# -----------------------------------------------------------------------------
# Image tag of ghcr.io/rmyndharis/openwa.
OPENWA_VERSION=0.23.6
# Host port for the OpenWA dashboard, published on 127.0.0.1 only. Reach it
# from your machine with: ssh -L 2785:127.0.0.1:2785 your-server
OPENWA_PORT=2785
# How the API and worker reach OpenWA. Default: the openwa service. For an
# existing external OpenWA (e.g. on Railway), set its URL here.
OPENWA_BASE_URL=http://openwa:2785
# Browser address of the OpenWA dashboard, linked from the setup page for the
# WhatsApp QR pairing. Default: http://127.0.0.1:$OPENWA_PORT (through the SSH
# tunnel above). OPENWA_BASE_URL is internal and not reachable from a browser.
OPENWA_DASHBOARD_URL=
# The OpenWA session id (the UUID OpenWA assigns, not its name). Webhooks for
# any other session are rejected.
OPENWA_SESSION_ID=
# WABrain's OpenWA key. Create it in the OpenWA dashboard (API Keys) with
# role "viewer", allowed sessions = only OPENWA_SESSION_ID, and NO allowed
# chats (the history import needs the session-wide message list). Never the
# admin key or an operator key. Without it, media and the history import are
# skipped. See docs/OPENWA_SETUP.md.
OPENWA_READ_API_KEY=
# Time zone for OpenWA logs and its "today" statistics.
TZ=UTC

# -----------------------------------------------------------------------------
# Owner identity (default intake filter for groups)
# -----------------------------------------------------------------------------
# Your own WhatsApp JID(s), comma-separated, used to detect @mentions in groups.
SELF_JID=
# Names that count as addressing you in a group, comma-separated (e.g. Alex,@Alex).
SELF_ALIASES=

# -----------------------------------------------------------------------------
# Push notifications
# -----------------------------------------------------------------------------
# VAPID contact sent to push services: a mailto: address or an https: URL.
# VAPID keys themselves are generated on first boot and stored in the database.
VAPID_SUBJECT=
# Profile "push" (self-hosted ntfy as the UnifiedPush distributor):
# Public domain of ntfy (Caddy serves it with the "https" profile).
NTFY_DOMAIN=
# Public base URL ntfy puts into UnifiedPush endpoints. Defaults to
# https://$NTFY_DOMAIN.
NTFY_BASE_URL=
# Hostname exempt from the API's private-address check for push endpoints. Set
# it to NTFY_DOMAIN when that name resolves to a private address from inside
# the containers (for example split DNS or a LAN-only server).
NTFY_HOST=
# ntfy access control: everything denied except the random UnifiedPush "up*"
# topics. See https://docs.ntfy.sh/config/#access-control before changing.
NTFY_AUTH_DEFAULT_ACCESS=deny-all
NTFY_AUTH_ACCESS=*:up*:rw
NTFY_VERSION=v2.28.0

# -----------------------------------------------------------------------------
# Model providers (fallback; the setup page stores per-role settings too)
# -----------------------------------------------------------------------------
# Roles: TEXT (analysis), VISION (images; defaults to TEXT), TRANSCRIPTION
# (voice notes), EMBEDDING (search; defaults to text-embedding-3-large, 1536
# dimensions). PROVIDER is one of: openai, anthropic, openai-compatible.
# openai-compatible (Ollama, OpenRouter, LM Studio...) needs BASE_URL.
# Anthropic has no transcription or embedding models.
AI_TEXT_PROVIDER=
AI_TEXT_MODEL=
AI_TEXT_API_KEY=
AI_TEXT_BASE_URL=
# openai-compatible only: whether the endpoint supports JSON-schema outputs (default true).
AI_TEXT_STRUCTURED_OUTPUTS=
# openai only: reasoning effort for every call (none, minimal, low, medium, high, xhigh, max).
AI_TEXT_REASONING_EFFORT=
# Optional daily budgets per role (blank = unlimited).
AI_TEXT_DAILY_TOKEN_LIMIT=
AI_TEXT_DAILY_CALL_LIMIT=

AI_VISION_PROVIDER=
AI_VISION_MODEL=
AI_VISION_API_KEY=
AI_VISION_BASE_URL=
AI_VISION_STRUCTURED_OUTPUTS=
AI_VISION_REASONING_EFFORT=
AI_VISION_DAILY_TOKEN_LIMIT=
AI_VISION_DAILY_CALL_LIMIT=

AI_TRANSCRIPTION_PROVIDER=
AI_TRANSCRIPTION_MODEL=
AI_TRANSCRIPTION_API_KEY=
AI_TRANSCRIPTION_BASE_URL=
AI_TRANSCRIPTION_DAILY_TOKEN_LIMIT=
AI_TRANSCRIPTION_DAILY_CALL_LIMIT=

AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
# Vector size (max 2000). Default 1536 for openai; only sent when set otherwise.
AI_EMBEDDING_DIMENSIONS=
AI_EMBEDDING_DAILY_TOKEN_LIMIT=
AI_EMBEDDING_DAILY_CALL_LIMIT=

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# debug | info | warn | error (also used by OpenWA).
LOG_LEVEL=info
# Apply database migrations on start. API and worker take a lock, so both may.
RUN_MIGRATIONS=true
# Run the job worker inside the API process (small installs). When true, stop
# the separate worker: docker compose up -d --scale worker=0
EMBEDDED_WORKER=false
# Owner session lifetime on the setup page, in hours (1-720).
SESSION_TTL_HOURS=12
# Image names for the built API and worker images.
WABRAIN_API_IMAGE=wabrain-api:latest
WABRAIN_WORKER_IMAGE=wabrain-worker:latest
# Image tag of caddy for the "https" profile.
CADDY_VERSION=2.10-alpine

# -----------------------------------------------------------------------------
# Pipeline limits and timings (blank = default shown)
# -----------------------------------------------------------------------------
# Quiet period before a chat is analyzed (90000).
ANALYSIS_DEBOUNCE_MS=
# Upper bound on postponing a busy chat's analysis (600000).
ANALYSIS_MAX_WAIT_MS=
# Messages per analysis run, 1-200 (40).
ANALYSIS_MAX_BURST_MESSAGES=
# Preceding messages included as context, 0-100 (30).
ANALYSIS_PRECEDING_MESSAGES=
# How long analysis waits for a burst's media (600000) and how often it re-checks (15000).
MEDIA_WAIT_MAX_MS=
MEDIA_RECHECK_MS=
# Model call timeout (120000) and OpenWA media download timeout (30000).
MODEL_TIMEOUT_MS=
MEDIA_FETCH_TIMEOUT_MS=
# Media limits: image bytes (10485760), audio bytes (16777216), audio seconds (600), attempts 1-20 (4).
MEDIA_MAX_IMAGE_BYTES=
MEDIA_MAX_AUDIO_BYTES=
MEDIA_MAX_AUDIO_SECONDS=
MEDIA_MAX_ATTEMPTS=
# PDFs: file bytes (20971520), pages read 1-50 (8), pixels per rendered page (2000000), pixels per
# document (16000000), PNG bytes sent to the vision model per document (12582912), and the deadline
# for opening and rendering one PDF (60000). PDFs whose pages all have a text layer skip the model.
MEDIA_MAX_PDF_BYTES=
MEDIA_MAX_PDF_PAGES=
MEDIA_MAX_PDF_PAGE_PIXELS=
MEDIA_MAX_PDF_TOTAL_PIXELS=
MEDIA_MAX_PDF_IMAGE_BYTES=
MEDIA_PDF_TIMEOUT_MS=
# Retry delay while no text provider is configured (900000).
PROVIDER_RETRY_MS=
# Catch-up windows after worker downtime: reminders (3600000), daily summary (7200000).
REMINDER_GRACE_MS=
SUMMARY_WINDOW_MS=
